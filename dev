#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TESTING_DIR="$(cd "$SCRIPT_DIR/../snippen-testing" && pwd)"
COMPOSE_TOOLS="$TESTING_DIR/compose.tools.yml"
COMPOSE_STACK=(-f "$TESTING_DIR/docker-compose.yml" -f "$TESTING_DIR/docker-compose.dev.yml")

run_tool() {
  docker compose -f "$COMPOSE_TOOLS" run -T --rm --no-deps sms-tools "$@"
}

run_interactive() {
  docker compose -f "$COMPOSE_TOOLS" run --rm --no-deps sms-tools "$@"
}

run_usb_tool() {
  if command -v podman >/dev/null 2>&1; then
    local image="snippen-testing-sms-tools:latest"
    if ! podman image exists "$image" >/dev/null 2>&1; then
      docker compose -f "$COMPOSE_TOOLS" build sms-tools
    fi
    local tty_flags=(-i)
    if [ -t 0 ] && [ -t 1 ]; then
      tty_flags=(-it)
    fi
    local dev_flags=()
    local dev_path
    for dev_path in /dev/ttyACM* /dev/ttyUSB*; do
      if [ -e "$dev_path" ]; then
        dev_flags+=(--device="$dev_path")
      fi
    done
    podman run --rm "${tty_flags[@]}" \
      --userns=keep-id \
      --group-add=keep-groups \
      "${dev_flags[@]}" \
      -v "$SCRIPT_DIR:/workspaces/snippen-sms-service" \
      -w /workspaces/snippen-sms-service \
      "$image" "$@"
  else
    run_tool "$@"
  fi
}

exec_container() {
  local flags=()
  if [ ! -t 0 ] || [ ! -t 1 ]; then
    flags+=(-T)
  fi
  if [ $# -eq 0 ]; then
    docker compose "${COMPOSE_STACK[@]}" exec "${flags[@]}" snippen-sms-service sh -c 'command -v bash >/dev/null 2>&1 && exec bash || exec sh'
  else
    docker compose "${COMPOSE_STACK[@]}" exec "${flags[@]}" snippen-sms-service "$@"
  fi
}
usage() {
  cat <<'EOF'
Usage: ./dev <command> [args...]

Tooling (runs in ephemeral sms-tools container with USB /dev pass-through):
  test               Run pytest
  lint               Run ruff check
  lint:fix           Run ruff check --fix && ruff format
  deploy [args...]   Run scripts/deploy_firmware.py against USB ESP32
  mpremote [args...] Run mpremote against USB ESP32
  esptool [args...]  Run esptool against USB ESP32
  pytest [args...]   Run pytest with custom args
  ruff [args...]     Run ruff with custom args
  shell              Open interactive bash shell in sms-tools
  container [cmd...] Run command (or shell) in running snippen-sms-service container
  build              Build sms-tools image
EOF
}

cmd="${1:-help}"
shift || true

case "$cmd" in
  test)           run_tool pytest "$@" ;;
  lint)           run_tool ruff check . "$@" ;;
  lint:fix)       run_tool bash -lc "ruff check --fix . && ruff format ." ;;
  deploy)         run_usb_tool python scripts/deploy_firmware.py "$@" ;;
  mpremote)       run_usb_tool python -m mpremote "$@" ;;
  esptool)        run_usb_tool python -m esptool "$@" ;;
  pytest)         run_tool pytest "$@" ;;
  ruff)           run_tool ruff "$@" ;;
  shell)          run_interactive bash ;;
  container)      exec_container "$@" ;;
  build)          docker compose -f "$COMPOSE_TOOLS" build sms-tools ;;
  help|-h|--help) usage ;;
  *)
    echo "Unknown command: $cmd" >&2
    usage >&2
    exit 1
    ;;
esac
